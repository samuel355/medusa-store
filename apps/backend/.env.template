# Comma-separated origins allowed to call this API.
# Local dev defaults below; in production STORE_CORS must include the
# deployed Vercel storefront URL(s), e.g.:
#   STORE_CORS=https://your-store.vercel.app
#   ADMIN_CORS=https://your-backend.onrender.com
#   AUTH_CORS=https://your-store.vercel.app,https://your-backend.onrender.com
STORE_CORS=http://localhost:3000,http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Leave disabled for local development to use Medusa's built-in event/cache/locking defaults.
# Enable only when the URL is reachable from the backend runtime.
MEDUSA_REDIS_ENABLED=false
REDIS_URL=
# Generate real random values for production, e.g. `openssl rand -hex 32`.
# Never reuse the "supersecret" dev placeholder outside local development.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DATABASE_SCHEMA=medusastore
DB_NAME=begnon-medusa

# Used by the admin dashboard's "Open shop" links so they point at the real
# deployed storefront instead of guessing it lives on this same host. Only
# PLUGIN_-prefixed vars reach the admin browser bundle (@medusajs/admin-bundler
# strips the prefix) — leave unset for local dev, required in production.
# PLUGIN_STOREFRONT_URL=https://your-store.vercel.app

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
ARKESEL_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
