# Comma-separated origins allowed to call this API. In production, STORE_CORS
# needs the Vercel storefront URL and ADMIN_CORS/AUTH_CORS need this
# backend's own deployed URL.
STORE_CORS=http://localhost:3000,http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Leave disabled for local development to use Medusa's built-in event/cache/locking defaults.
# Enable only when the URL is reachable from the backend runtime.
MEDUSA_REDIS_ENABLED=false
REDIS_URL=
# Generate real random values for production, e.g. `openssl rand -hex 32`.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DATABASE_SCHEMA=begnon
DB_NAME=begnon-medusa

# Storefront URL for the admin's "Shop" link and the /welcome landing page.
# Required in production (unset locally falls back to localhost:3000); must
# be PLUGIN_-prefixed to reach the admin's browser bundle.
# PLUGIN_STORE_URL=https://your-store.vercel.app

PAYSTACK_SECRET_KEY=

# Order SMS (customer + platform alerts). Provider is only registered when
# ARKESEL_API_KEY is set, so it's safe to leave blank locally.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Begnon

# Order email (customer + platform alerts). Provider is only registered when
# RESEND_API_KEY is set, so it's safe to leave blank locally.
# onboarding@resend.dev needs no domain verification — use it until a custom
# domain is verified in Resend, then switch to an address at that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Begnon <onboarding@resend.dev>

# Where "new order" platform alerts go. Leave blank to skip platform alerts.
# PLATFORM_ADMIN_NAME is cosmetic only (used to greet the admin by name in
# the alert) and defaults to "Admin" if unset.
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
