# Comma-separated origins allowed to call this API. In production, STORE_CORS
# needs the Vercel storefront URL and ADMIN_CORS/AUTH_CORS need this
# backend's own deployed URL.
STORE_CORS=http://localhost:3000,http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Leave disabled for local development to use Medusa's built-in event/cache/locking defaults.
# Enable only when the URL is reachable from the backend runtime.
MEDUSA_REDIS_ENABLED=false
REDIS_URL=
# Generate real random values for production, e.g. `openssl rand -hex 32`.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DATABASE_SCHEMA=medusastore
DB_NAME=begnon-medusa

# Storefront URL for the admin's "Open shop" links. Required in production
# (unset locally); must be PLUGIN_-prefixed to reach the admin bundle.
# PLUGIN_STOREFRONT_URL=https://your-store.vercel.app

PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
ARKESEL_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
