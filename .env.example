NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings -> API -> service_role secret. Required for the
# Arkesel-based phone OTP flow to mint a session after verification
# (src/lib/auth/phoneSession.ts) - not just a placeholder.
SUPABASE_SERVICE_ROLE_KEY=

# Medusa Store API configuration. All three values are required by the
# storefront integration; obtain the key and region ID from the Medusa Admin.
# In production (Vercel), point these at the deployed Render backend, e.g.:
#   NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-backend.onrender.com
#   NEXT_PUBLIC_MEDUSA_ADMIN_URL=https://your-backend.onrender.com/app/dashboard
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# /admin redirects recognized store admins here (Medusa's own Admin dashboard).
NEXT_PUBLIC_MEDUSA_ADMIN_URL=http://localhost:9000/app/dashboard
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_REGION_ID=
NEXT_PUBLIC_MEDUSA_CART_ENABLED=true

# Server-only secret used to deterministically derive each signed-in customer's
# Medusa customer account password (src/lib/medusa/customerIdentity.ts) - never
# sent to the browser, never stored per-customer. Generate with:
#   openssl rand -hex 32
MEDUSA_CUSTOMER_LINK_SECRET=

# Direct Postgres connection to the Supabase project (used for all commerce data
# in the "medusastore" schema). Include ?options=-c%20search_path%3Dmedusastore
# in the connection string, or set DATABASE_SCHEMA and keep it in sync with client.ts.
DATABASE_URL=
DATABASE_SCHEMA=medusastore

PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

ARKESEL_API_KEY=
ARKESEL_SENDER_ID=

REDIS_URL=redis://localhost:6379
# Production example: rediss://default:<password>@<host>:6379

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
